{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "scripts/**/*.ts"]
}
